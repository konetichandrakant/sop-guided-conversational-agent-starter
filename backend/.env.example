# Copy this file to backend/.env and fill in your key:   copy .env.example .env
#
# MODEL_NAME is provider-prefixed; install the matching package (requirements.txt):
#   openai:gpt-4o-mini            -> langchain-openai
#   anthropic:claude-sonnet-4-5   -> langchain-anthropic
#   google_genai:gemini-2.5-pro   -> langchain-google-genai
MODEL_NAME=openai:gpt-4o-mini
MODEL_API_TOKEN=your-api-key-here
