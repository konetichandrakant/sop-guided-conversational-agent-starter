# Copy this file to backend/.env and fill in your api_key to run the backend up and running

# ** NOTE: Only update this **
# Create API key from openrouter and use it here instead to properly run the agent
MODEL_API_TOKEN=your-api-key-here

# MODEL_NAME: openrouter:openai/gpt-4o-mini -> langchain-openai (OpenRouter key, any vendor model)
MODEL_NAME=openrouter:openai/gpt-4o-mini

# OpenRouter endpoint (change only if you proxy it)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
